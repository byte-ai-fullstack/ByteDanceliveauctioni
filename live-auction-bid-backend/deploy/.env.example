# Copy to an untracked deploy/.env for local Docker Compose runs, then fill every required value.
# Production secrets are provisioned on the deployment host; never commit or package deploy/.env.

AUCTION_STORAGE_PROVIDER=tos
AUCTION_ENV=dev
AUCTION_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://120.79.7.110,http://120.79.7.110:8080
AUCTION_WS_ALLOW_MISSING_ORIGIN=true
AUCTION_WS_TICKET_TTL=60s
AUCTION_OUTBOX_SHARDS=16
AUCTION_OUTBOX_PENDING_LIMIT=0
AUCTION_DB_MAX_OPEN_CONNS=20
AUCTION_DB_MAX_IDLE_CONNS=10
AUCTION_DB_CONN_MAX_LIFETIME=30m
AUCTION_DB_CONN_MAX_IDLE_TIME=2m
AUCTION_REDIS_POOL_SIZE=128
AUCTION_REDIS_MIN_IDLE_CONNS=16
AUCTION_REDIS_MAXMEMORY=512mb

# gateway -> auction-service private synchronous command path.
AUCTION_COMMAND_GRPC_TIMEOUT=3s
AUCTION_OPERATIONS_ADDR=:18086
NATS_AUCTION_SERVICE_PASSWORD=auction-service-local-only
NATS_DOMAIN_RELAY_PASSWORD=domain-relay-local-only
NATS_GATEWAY_PASSWORD=gateway-local-only
NATS_MONITOR_PASSWORD=monitor-local-only

# Prometheus exporters. Production MySQL creates the read-only `exporter`
# principal through the DBA/secret-manager workflow before monitoring starts.
AUCTION_KAFKA_EXPORTER_BROKER=kafka:29092
AUCTION_KAFKA_EXPORTER_SECURITY_PROTOCOL=PLAINTEXT
AUCTION_KAFKA_EXPORTER_SASL_MECHANISM=PLAIN
AUCTION_KAFKA_EXPORTER_SASL_USERNAME=
AUCTION_KAFKA_EXPORTER_SASL_PASSWORD=
AUCTION_KAFKA_EXPORTER_TLS_SERVER_NAME=
AUCTION_KAFKA_EXPORTER_TLS_CA_FILE=
AUCTION_KAFKA_EXPORTER_TLS_INSECURE_SKIP_VERIFY=false
AUCTION_NATS_EXPORTER_URL=http://nats:8222
AUCTION_MYSQL_EXPORTER_PASSWORD=
AUCTION_MONITOR_SEARCH_ENABLED=false

# Redis Outbox -> Kafka Relay. Local Compose injects plaintext endpoints;
# production mounts a Kafka client.properties Secret and uses Redis Sentinel.
AUCTION_OUTBOX_RELAY_LEASE_TTL=15s
AUCTION_OUTBOX_RELAY_RENEW_INTERVAL=5s
AUCTION_OUTBOX_RELAY_OPERATION_TIMEOUT=10s
AUCTION_OUTBOX_RELAY_RELEASE_TIMEOUT=2s
AUCTION_KAFKA_CLIENT_PROPERTIES_FILE=
AUCTION_KAFKA_BROKERS=127.0.0.1:19092
AUCTION_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
AUCTION_KAFKA_SASL_MECHANISM=
AUCTION_KAFKA_SASL_USERNAME=
AUCTION_KAFKA_SASL_PASSWORD=
AUCTION_KAFKA_TLS_CA_FILE=
AUCTION_KAFKA_TLS_SERVER_NAME=

# Kafka Runtime Topic -> MySQL Projector. The DB offset is authoritative;
# the Kafka group offset is only a lag/fast-start hint.
AUCTION_PROJECTOR_GROUP_ID=auction-projector-v1
AUCTION_PROJECTOR_OPERATIONS_ADDR=:18083
AUCTION_PROJECTOR_MAX_POLL_RECORDS=500
AUCTION_PROJECTOR_SESSION_TIMEOUT=30s
AUCTION_PROJECTOR_HEARTBEAT_INTERVAL=3s
AUCTION_PROJECTOR_RETRY_ATTEMPTS=5
AUCTION_PROJECTOR_RETRY_BASE_DELAY=20ms
AUCTION_PROJECTOR_RETRY_MAX_DELAY=1s
AUCTION_PROJECTOR_DB_MAX_OPEN_CONNS=12
AUCTION_PROJECTOR_DB_MAX_IDLE_CONNS=6
AUCTION_PROJECTOR_DB_CONN_MAX_LIFETIME=30m
AUCTION_PROJECTOR_DB_CONN_MAX_IDLE_TIME=2m

# MySQL Domain Outbox -> Kafka domain topics. Claim limit must not exceed
# concurrency; the lease must remain at least four times the operation timeout.
AUCTION_DOMAIN_RELAY_OPERATIONS_ADDR=:18084
AUCTION_DOMAIN_RELAY_CLAIM_LIMIT=16
AUCTION_DOMAIN_RELAY_CONCURRENCY=16
AUCTION_DOMAIN_RELAY_LEASE_TTL=30s
AUCTION_DOMAIN_RELAY_OPERATION_TIMEOUT=5s
AUCTION_DOMAIN_RELAY_IDLE_INTERVAL=250ms
AUCTION_DOMAIN_RELAY_RETRY_BASE=100ms
AUCTION_DOMAIN_RELAY_RETRY_MAX=10s
AUCTION_DOMAIN_RELAY_STATS_INTERVAL=5s
AUCTION_DOMAIN_RELAY_MAX_ATTEMPTS=8
AUCTION_DOMAIN_RELAY_DB_MAX_OPEN_CONNS=8
AUCTION_DOMAIN_RELAY_DB_MAX_IDLE_CONNS=4
AUCTION_DOMAIN_RELAY_DB_CONN_MAX_LIFETIME=30m
AUCTION_DOMAIN_RELAY_DB_CONN_MAX_IDLE_TIME=2m

# Kafka order.enrichment.requested -> MySQL enrichment effect. The consumer
# commits offsets only after the enrichment row or its DLQ copy is acknowledged.
AUCTION_ENRICHMENT_GROUP_ID=auction-order-enrichment-v1
AUCTION_ENRICHMENT_OPERATIONS_ADDR=:18087
AUCTION_ENRICHMENT_MAX_POLL_RECORDS=100
AUCTION_ENRICHMENT_SESSION_TIMEOUT=30s
AUCTION_ENRICHMENT_HEARTBEAT_INTERVAL=3s
AUCTION_ENRICHMENT_RETRY_ATTEMPTS=5
AUCTION_ENRICHMENT_RETRY_BASE=100ms
AUCTION_ENRICHMENT_RETRY_MAX=5s
AUCTION_ENRICHMENT_OPERATION_TIMEOUT=5s
AUCTION_ENRICHMENT_DB_MAX_OPEN_CONNS=8
AUCTION_ENRICHMENT_DB_MAX_IDLE_CONNS=4
AUCTION_ENRICHMENT_DB_CONN_MAX_LIFETIME=30m
AUCTION_ENRICHMENT_DB_CONN_MAX_IDLE_TIME=2m

# Redis due-ZSET candidate scanner. It never reads MySQL to decide settlement;
# close_if_expired.lua rechecks Redis TIME and current ends_at atomically.
AUCTION_CLOSE_WORKER_OPERATIONS_ADDR=:18085
AUCTION_CLOSE_WORKER_INTERVAL=250ms
AUCTION_CLOSE_WORKER_BATCH_LIMIT=200
AUCTION_CLOSE_WORKER_CONCURRENCY=8
AUCTION_CLOSE_WORKER_OPERATION_TIMEOUT=2s

# Optional buyer AI semantic search.
# To enable locally, run docker compose with --profile search and set:
# AUCTION_SEARCH_PROVIDER=pgvector
# AUCTION_SEARCH_PG_DSN=postgres://auction_search:auction_search_dev@pgvector:5432/live_auction_search?sslmode=disable
# AUCTION_EMBEDDING_API_KEY=your_dashscope_key
AUCTION_SEARCH_PROVIDER=
AUCTION_SEARCH_PG_DSN=
AUCTION_SEARCH_PG_PASSWORD=auction_search_dev
AUCTION_SEARCH_ES_URL=
AUCTION_SEARCH_ES_USERNAME=
AUCTION_SEARCH_ES_PASSWORD=
AUCTION_SEARCH_ES_ALIAS=auction-lots-current
AUCTION_SEARCH_ES_TIMEOUT=3s
AUCTION_SEARCH_ES_MAX_RESPONSE_BYTES=1048576
AUCTION_SEARCH_QUERY_TIMEOUT=5s
AUCTION_EMBEDDING_PROVIDER=dashscope
AUCTION_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AUCTION_EMBEDDING_MODEL=text-embedding-v4
AUCTION_EMBEDDING_MODEL_VERSION=text-embedding-v4
AUCTION_EMBEDDING_DIMENSIONS=1024
AUCTION_EMBEDDING_BATCH_SIZE=10
AUCTION_EMBEDDING_TIMEOUT=8s
AUCTION_EMBEDDING_COST_PER_MILLION_TOKENS=0
AUCTION_EMBEDDING_API_KEY=

# Independent auction.lot.state.v1 -> embedding -> pgvector consumer.
AUCTION_VECTOR_GROUP_ID=search-pgvector-v1
AUCTION_VECTOR_OPERATIONS_ADDR=:18089
AUCTION_VECTOR_MAX_POLL_RECORDS=100
AUCTION_VECTOR_SESSION_TIMEOUT=30s
AUCTION_VECTOR_HEARTBEAT_INTERVAL=3s
AUCTION_VECTOR_RETRY_ATTEMPTS=5
AUCTION_VECTOR_RETRY_BASE=200ms
AUCTION_VECTOR_RETRY_MAX=10s
AUCTION_VECTOR_OPERATION_TIMEOUT=10s
AUCTION_VECTOR_DB_MAX_OPEN_CONNS=8
AUCTION_VECTOR_DB_MAX_IDLE_CONNS=4
AUCTION_VECTOR_DB_CONN_MAX_LIFETIME=30m
AUCTION_VECTOR_DB_CONN_MAX_IDLE_TIME=2m

# Independent auction.lot.state.v1 -> Elasticsearch consumer.
AUCTION_ES_URL=http://elasticsearch:9200
AUCTION_ES_USERNAME=
AUCTION_ES_PASSWORD=
AUCTION_ES_INDEX_NAME=auction-lots-v1
AUCTION_ES_WRITE_ALIAS=auction-lots-current
AUCTION_ES_GROUP_ID=search-es-v1
AUCTION_ES_OPERATIONS_ADDR=:18088
AUCTION_ES_MAX_POLL_RECORDS=100
AUCTION_ES_SESSION_TIMEOUT=30s
AUCTION_ES_HEARTBEAT_INTERVAL=3s
AUCTION_ES_RETRY_ATTEMPTS=5
AUCTION_ES_RETRY_BASE=200ms
AUCTION_ES_RETRY_MAX=10s
AUCTION_ES_OPERATION_TIMEOUT=10s
AUCTION_ES_REQUEST_TIMEOUT=5s
AUCTION_ES_MAX_RESPONSE_BYTES=1048576
AUCTION_ES_DB_MAX_OPEN_CONNS=4
AUCTION_ES_DB_MAX_IDLE_CONNS=2
AUCTION_ES_DB_CONN_MAX_LIFETIME=30m
AUCTION_ES_DB_CONN_MAX_IDLE_TIME=2m

# One-shot ES/pgvector rebuilds. Both Compose services default to --dry-run.
# pgvector write runs also require an explicit --max-new-embeddings fee cap;
# zero means existing compatible vectors may be reused but no paid calls occur.
AUCTION_ES_MAPPING_FILE=/app/elasticsearch/index-v1.json
AUCTION_SEARCH_REBUILD_STARTUP_TIMEOUT=30s
AUCTION_SEARCH_REBUILD_OPERATION_TIMEOUT=15s
# Continuous MySQL -> ES/pgvector identity sampling and Kafka repair.
AUCTION_SEARCH_RECONCILE_STARTUP_TIMEOUT=30s
AUCTION_SEARCH_RECONCILE_OPERATIONS_ADDR=:18090
AUCTION_SEARCH_RECONCILE_INTERVAL=1m
AUCTION_SEARCH_RECONCILE_PAGE_SIZE=100
AUCTION_SEARCH_RECONCILE_CONCURRENCY=8
AUCTION_SEARCH_RECONCILE_OPERATION_TIMEOUT=5s
AUCTION_AI_PROVIDER=deepseek
AUCTION_AI_BASE_URL=https://api.deepseek.com
AUCTION_AI_MODEL=deepseek-chat
AUCTION_AI_TIMEOUT=8s
AUCTION_AI_MOCK_ON_FAILURE=true
AUCTION_AI_API_KEY=
AUCTION_PAYMENT_PROVIDER=mock

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=false
AUCTION_TOS_ENDPOINT=
AUCTION_TOS_REGION=
AUCTION_TOS_BUCKET=
AUCTION_TOS_PUBLIC_BASE_URL=
AUCTION_TOS_USE_SSL=true

# Temporary upload objects live under temp/{bizType}/yyyy/mm in OSS.
# They are marked attached when a lot is saved; otherwise delete is attempted on page leave
# and the backend cleanup worker removes expired temporary objects.
AUCTION_TEMP_ASSET_CLEANUP_INTERVAL=1h

AUCTION_TOS_ACCESS_KEY=
AUCTION_TOS_SECRET_KEY=
